@using LakeCountrySpanish.Web.Models.Entities
@model LakeCountrySpanish.Web.Models.ViewModels.ProgramEnrollmentFormViewModel
@{
    var p = Model.Program;
    ViewData["Title"] = p.Name;
    ViewData["MetaDescription"] = string.IsNullOrEmpty(p.TagLine)
        ? $"Enroll your child in {p.Name} — Lake Country Spanish."
        : p.TagLine;
    // Program-controlled hero background; falls back to a soft accent gradient
    // when the admin left the field blank.
    var heroStyle = string.IsNullOrEmpty(p.HeroImagePath)
        ? "background: linear-gradient(135deg, #4361ee 0%, #e85a42 100%);"
        : $"background-image: linear-gradient(135deg, rgba(30,58,95,0.55), rgba(232,90,66,0.45)), url('{p.HeroImagePath}'); background-size: cover; background-position: center;";

    // Shared field classes — same M3-expressive treatment as the admin form so
    // the enrollment experience feels consistent from the parent's perspective.
    var fieldClass    = "block w-full rounded-lg border-2 border-gray-300 bg-white px-3 py-2.5 text-base text-gray-900 shadow-sm placeholder-gray-400 transition-colors focus:border-indigo-500 focus:outline-none focus:ring-4 focus:ring-indigo-500/15";
    var textareaClass = "block w-full rounded-lg border-2 border-gray-300 bg-white px-3 py-2.5 text-sm text-gray-900 shadow-sm placeholder-gray-400 transition-colors focus:border-indigo-500 focus:outline-none focus:ring-4 focus:ring-indigo-500/15";
    var labelClass    = "block text-sm font-semibold text-gray-800 mb-1.5";
    var hintClass     = "mt-1.5 text-xs text-gray-500";
    var errorClass    = "mt-1 text-xs font-medium text-red-600";
}

<div class="bg-gray-100 min-h-screen">

    <!-- Hero -->
    <div class="relative py-20 text-white" style="@heroStyle">
        <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
            <h1 class="font-display text-4xl sm:text-5xl font-bold drop-shadow">@p.Name</h1>
            @if (!string.IsNullOrEmpty(p.TagLine))
            {
                <p class="mt-3 text-lg text-white/95">@p.TagLine</p>
            }
            <div class="mt-5 flex flex-wrap justify-center gap-2 text-sm">
                @{
                    // Skip Karen's "0" placeholder (which means "no grade restriction",
                    // typically an adult program) — otherwise the pill reads literally
                    // "Grades 0" which is meaningless to parents.
                    var gradeTrimmed = p.GradeRange?.Trim();
                    var hasMeaningfulGrade = !string.IsNullOrEmpty(gradeTrimmed) && gradeTrimmed != "0";
                    var hasAges = p.AgeMin > 0;
                    var isAdultPill = p.AgeMin >= 18;

                    // Adult programs get a friendlier "Adults · Ages 18+" label
                    // instead of the raw "ages 18–99" range (per Cece's Aug 27 ask).
                    // We use "18+" when AgeMax is Karen's 99 no-upper-limit sentinel,
                    // and the explicit range otherwise ("Ages 18–25" if she ever runs
                    // a young-adults class).
                    string? agesText = null;
                    if (isAdultPill)
                    {
                        agesText = p.AgeMax >= 99
                            ? $"Adults · Ages {p.AgeMin}+"
                            : $"Adults · Ages {p.AgeMin}–{p.AgeMax}";
                    }
                    else if (hasAges)
                    {
                        agesText = $"ages {p.AgeMin}–{p.AgeMax}";
                    }
                }
                @if (hasMeaningfulGrade || agesText is not null)
                {
                    <span class="bg-white/95 text-gray-900 px-3 py-1 rounded-full font-semibold shadow-sm">@(hasMeaningfulGrade ? $"Grades {gradeTrimmed}" : "")@(hasMeaningfulGrade && agesText is not null ? " · " : "")@agesText</span>
                }
                <span class="bg-white/95 text-gray-900 px-3 py-1 rounded-full font-semibold shadow-sm">@p.MeetingDays · @p.StartTime.ToString("h:mm tt")–@p.EndTime.ToString("h:mm tt")</span>
                <span class="bg-white/95 text-gray-900 px-3 py-1 rounded-full font-semibold shadow-sm">@p.StartDate.ToString("MMM d") – @p.EndDate.ToString("MMM d, yyyy")</span>
            </div>
        </div>
    </div>

    <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6 lg:px-8">

        @if (TempData["InfoMessage"] is string info)
        {
            <div class="mb-6 rounded-xl border-2 border-blue-200 bg-blue-50 p-4 shadow-sm text-sm text-blue-900">
                @info
            </div>
        }

        <!-- Program description -->
        @if (!string.IsNullOrEmpty(p.Description))
        {
            <div class="prose prose-slate max-w-none mb-8 bg-white p-6 rounded-2xl shadow-sm border border-gray-200">
                @Html.Raw(Markdig.Markdown.ToHtml(p.Description))
            </div>
        }

        <!-- Enrollment form -->
        <form method="post" asp-action="Submit" asp-route-slug="@p.Slug" class="space-y-6">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ProgramId" />
            <input type="hidden" asp-for="ProgramSlug" />

            @* Honeypot: bots fill every input they find; real users never
               see this one (off-screen positioning + aria-hidden +
               tabindex=-1 + autocomplete=off). Any submit with Website
               non-empty is silently dropped in JoinController.Submit.
               Do NOT use display:none — some browsers skip binding such
               fields entirely, and some bot heuristics detect display:none
               as a honeypot and skip it. Off-screen absolute positioning
               is more reliable at fooling naive form-fillers. *@
            <div aria-hidden="true" style="position:absolute; left:-9999px; top:-9999px; width:1px; height:1px; overflow:hidden;">
                <label for="Website">Website (leave blank)</label>
                <input asp-for="Website" type="text" tabindex="-1" autocomplete="off" />
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="rounded-xl border-2 border-red-300 bg-red-50 p-4 shadow-sm">
                    <div class="flex items-start gap-2">
                        <span class="text-red-600 text-lg leading-none mt-0.5">⚠</span>
                        <div class="flex-1">
                            <div class="text-sm font-bold text-red-800 mb-1">Please fix the following before submitting:</div>
                            <ul class="list-disc list-inside text-sm text-red-700 space-y-0.5">
                                @foreach (var entry in ViewData.ModelState)
                                {
                                    foreach (var err in entry.Value.Errors)
                                    {
                                        <li>
                                            @if (!string.IsNullOrEmpty(entry.Key) && entry.Key != "Program")
                                            {
                                                <span class="font-semibold">@entry.Key:</span>
                                            }
                                            @(string.IsNullOrEmpty(err.ErrorMessage) ? "Invalid value" : err.ErrorMessage)
                                        </li>
                                    }
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            }

            @{
                // Same server-authoritative flag the ViewModel uses; drives conditional
                // rendering of the parent-child-only sections (Student + Pickup) and
                // relabels "About you (parent)" → "About you" for the adult flow.
                var isAdult = Model.IsAdultProgram;
            }

            <!-- Parent (or self, for adult programs) -->
            <section class="bg-white rounded-2xl shadow-md border-l-4 border-indigo-500 overflow-hidden">
                <header class="border-b border-gray-100 px-6 py-4 bg-indigo-50/40">
                    <h2 class="font-display text-lg font-bold text-gray-900 flex items-center gap-2">
                        <span class="text-indigo-600">①</span>
                        @(isAdult ? "About you" : "About you (the parent or guardian)")
                    </h2>
                </header>
                <div class="p-6 grid grid-cols-1 sm:grid-cols-2 gap-5">
                    <div>
                        <label asp-for="ParentFirstName" class="@labelClass"></label>
                        <input asp-for="ParentFirstName" class="@fieldClass" />
                        <span asp-validation-for="ParentFirstName" class="@errorClass"></span>
                    </div>
                    <div>
                        <label asp-for="ParentLastName" class="@labelClass"></label>
                        <input asp-for="ParentLastName" class="@fieldClass" />
                        <span asp-validation-for="ParentLastName" class="@errorClass"></span>
                    </div>
                    <div>
                        <label asp-for="ParentEmail" class="@labelClass"></label>
                        <input asp-for="ParentEmail" type="email" class="@fieldClass" placeholder="you@example.com" />
                        <span asp-validation-for="ParentEmail" class="@errorClass"></span>
                    </div>
                    <div>
                        <label asp-for="ParentPhone" class="@labelClass"></label>
                        <input asp-for="ParentPhone" type="tel" class="@fieldClass" placeholder="(262) 555-0100" />
                        <span asp-validation-for="ParentPhone" class="@errorClass"></span>
                    </div>
                    <div class="sm:col-span-2">
                        <label asp-for="ParentAddressLine1" class="@labelClass"></label>
                        <input asp-for="ParentAddressLine1" class="@fieldClass" />
                    </div>
                    <div>
                        <label asp-for="ParentCity" class="@labelClass"></label>
                        <input asp-for="ParentCity" class="@fieldClass" />
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label asp-for="ParentState" class="@labelClass"></label>
                            <input asp-for="ParentState" class="@fieldClass" />
                        </div>
                        <div>
                            <label asp-for="ParentZip" class="@labelClass"></label>
                            <input asp-for="ParentZip" class="@fieldClass" />
                        </div>
                    </div>
                </div>
            </section>

            @if (!isAdult)
            {
                <!-- Student — kid programs only. Adult programs skip this entirely
                     since the enrollee IS the student; controller mirrors the parent
                     name fields into student name on save. -->
                <section class="bg-white rounded-2xl shadow-md border-l-4 border-teal-500 overflow-hidden">
                    <header class="border-b border-gray-100 px-6 py-4 bg-teal-50/40">
                        <h2 class="font-display text-lg font-bold text-gray-900 flex items-center gap-2">
                            <span class="text-teal-600">②</span> About your child
                        </h2>
                    </header>
                    <div class="p-6 grid grid-cols-1 sm:grid-cols-2 gap-5">
                        <div>
                            <label asp-for="StudentFirstName" class="@labelClass"></label>
                            <input asp-for="StudentFirstName" class="@fieldClass" />
                            <span asp-validation-for="StudentFirstName" class="@errorClass"></span>
                        </div>
                        <div>
                            <label asp-for="StudentLastName" class="@labelClass"></label>
                            <input asp-for="StudentLastName" class="@fieldClass" />
                            <span asp-validation-for="StudentLastName" class="@errorClass"></span>
                        </div>
                        <div>
                            <label asp-for="StudentGrade" class="@labelClass"></label>
                            <input asp-for="StudentGrade" placeholder="e.g. 3, 4, 5, 6" class="@fieldClass" />
                        </div>
                        <div>
                            <label asp-for="StudentBirthDate" class="@labelClass"></label>
                            <input asp-for="StudentBirthDate" type="date" class="@fieldClass" />
                        </div>
                        <div class="sm:col-span-2">
                            <label asp-for="MedicalConcerns" class="@labelClass"></label>
                            <textarea asp-for="MedicalConcerns" rows="2" placeholder="Allergies, medications, conditions we should know about — or leave blank."
                                      class="@textareaClass"></textarea>
                        </div>
                        <div class="sm:col-span-2">
                            <label asp-for="StudentNotes" class="@labelClass"></label>
                            <textarea asp-for="StudentNotes" rows="2" placeholder="Anything else we should know about your child."
                                      class="@textareaClass"></textarea>
                        </div>
                    </div>
                </section>

                <!-- Emergency + pickup — kid programs only. Adult programs skip
                     both. If we later want emergency contact as optional info for
                     adults, we can add it back as its own opt-in section. -->
                <section class="bg-white rounded-2xl shadow-md border-l-4 border-amber-500 overflow-hidden">
                    <header class="border-b border-gray-100 px-6 py-4 bg-amber-50/40">
                        <h2 class="font-display text-lg font-bold text-gray-900 flex items-center gap-2">
                            <span class="text-amber-600">③</span> Emergency contact &amp; pickup
                        </h2>
                    </header>
                    <div class="p-6 grid grid-cols-1 sm:grid-cols-2 gap-5">
                        <div>
                            <label asp-for="EmergencyName" class="@labelClass"></label>
                            <input asp-for="EmergencyName" class="@fieldClass" />
                        </div>
                        <div>
                            <label asp-for="EmergencyPhone" class="@labelClass"></label>
                            <input asp-for="EmergencyPhone" type="tel" class="@fieldClass" />
                        </div>
                        <div class="sm:col-span-2">
                            <label asp-for="EmergencyRelationship" class="@labelClass"></label>
                            <input asp-for="EmergencyRelationship" placeholder="e.g. grandmother, aunt, family friend" class="@fieldClass" />
                        </div>
                        <div class="sm:col-span-2">
                            <label asp-for="PickupAuthorization" class="@labelClass"></label>
                            <textarea asp-for="PickupAuthorization" rows="3" placeholder="e.g.&#10;Jane Doe (mom)&#10;John Doe (dad)&#10;Sarah Smith (grandmother)"
                                      class="@textareaClass"></textarea>
                            <p class="@hintClass">Who is allowed to pick up your child from class? Include their relationship.</p>
                        </div>
                    </div>
                </section>
            }
            else
            {
                <!-- Adult programs: single optional "anything we should know" field
                     (medical concerns / dietary / access needs) in place of the whole
                     student + emergency + pickup block. Kept opt-in so casual signups
                     don't need to fill anything extra. -->
                <section class="bg-white rounded-2xl shadow-md border-l-4 border-teal-500 overflow-hidden">
                    <header class="border-b border-gray-100 px-6 py-4 bg-teal-50/40">
                        <h2 class="font-display text-lg font-bold text-gray-900 flex items-center gap-2">
                            <span class="text-teal-600">②</span> Anything we should know? <span class="text-xs font-normal text-gray-500">(optional)</span>
                        </h2>
                    </header>
                    <div class="p-6 grid grid-cols-1 gap-5">
                        <div>
                            <label asp-for="MedicalConcerns" class="@labelClass">Health / accessibility notes</label>
                            <textarea asp-for="MedicalConcerns" rows="2" placeholder="Allergies, medications, mobility needs, or anything else we should be aware of — or leave blank."
                                      class="@textareaClass"></textarea>
                        </div>
                        <div>
                            <label asp-for="StudentNotes" class="@labelClass">Anything else</label>
                            <textarea asp-for="StudentNotes" rows="2" placeholder="Your Spanish background, learning goals, or anything else — or leave blank."
                                      class="@textareaClass"></textarea>
                        </div>
                    </div>
                </section>
            }

            <!-- Payment choice -->
            <section class="bg-white rounded-2xl shadow-md border-l-4 border-rose-500 overflow-hidden">
                <header class="border-b border-gray-100 px-6 py-4 bg-rose-50/40">
                    <h2 class="font-display text-lg font-bold text-gray-900 flex items-center gap-2">
                        <span class="text-rose-600">④</span> Payment
                    </h2>
                </header>
                <div class="p-6 space-y-3">
                    <label class="flex items-start gap-3 p-4 rounded-lg border-2 border-gray-200 bg-white hover:border-rose-400 hover:bg-rose-50/40 cursor-pointer transition-all has-[:checked]:border-rose-500 has-[:checked]:bg-rose-50 has-[:checked]:shadow-md">
                        <input asp-for="PaymentType" type="radio" value="@ProgramPaymentType.FullOneTime" class="mt-1 h-5 w-5 text-rose-600 focus:ring-4 focus:ring-rose-500/15" />
                        <div class="flex-1">
                            <div class="font-bold text-gray-900">Pay in full — $@p.FullPrice.ToString("N2")</div>
                            <div class="text-sm text-gray-600 mt-0.5">One credit card charge, done.</div>
                        </div>
                    </label>

                    @if (p.InstallmentsEnabled)
                    {
                        <label class="flex items-start gap-3 p-4 rounded-lg border-2 border-gray-200 bg-white hover:border-rose-400 hover:bg-rose-50/40 cursor-pointer transition-all has-[:checked]:border-rose-500 has-[:checked]:bg-rose-50 has-[:checked]:shadow-md">
                            <input asp-for="PaymentType" type="radio" value="@ProgramPaymentType.TwoInstallment" class="mt-1 h-5 w-5 text-rose-600 focus:ring-4 focus:ring-rose-500/15" />
                            <div class="flex-1">
                                <div class="font-bold text-gray-900">
                                    @p.InstallmentCount installments of $@p.InstallmentAmount.ToString("N2")
                                </div>
                                <div class="text-sm text-gray-600 mt-0.5">
                                    First installment today; second charges automatically in about 30 days.
                                    @if (p.FinalInstallmentDueDate.HasValue)
                                    {
                                        <span>Final installment complete by @p.FinalInstallmentDueDate.Value.ToString("MMM d, yyyy").</span>
                                    }
                                </div>
                            </div>
                        </label>
                    }

                    @if (p.CashOptionEnabled)
                    {
                        <label class="flex items-start gap-3 p-4 rounded-lg border-2 border-gray-200 bg-white hover:border-rose-400 hover:bg-rose-50/40 cursor-pointer transition-all has-[:checked]:border-rose-500 has-[:checked]:bg-rose-50 has-[:checked]:shadow-md">
                            <input asp-for="PaymentType" type="radio" value="@ProgramPaymentType.CashInHand" class="mt-1 h-5 w-5 text-rose-600 focus:ring-4 focus:ring-rose-500/15" />
                            <div class="flex-1">
                                <div class="font-bold text-gray-900">I'll pay at the booth (cash or check)</div>
                                <div class="text-sm text-gray-600 mt-0.5">Skip online payment — we'll confirm receipt in person.</div>
                            </div>
                        </label>
                    }
                </div>
                @if (!string.IsNullOrEmpty(p.RefundPolicyText))
                {
                    <div class="mx-6 mb-6 p-3 rounded-lg bg-gray-50 border border-gray-200">
                        <p class="text-xs text-gray-600 italic">@p.RefundPolicyText</p>
                    </div>
                }
            </section>

            <!-- Waiver -->
            <section class="bg-white rounded-2xl shadow-md border-l-4 border-emerald-500 overflow-hidden">
                <header class="border-b border-gray-100 px-6 py-4 bg-emerald-50/40">
                    <h2 class="font-display text-lg font-bold text-gray-900 flex items-center gap-2">
                        <span class="text-emerald-600">⑤</span> Waiver
                    </h2>
                    <p class="text-xs text-gray-600 mt-0.5">Please read carefully and check the box to agree.</p>
                </header>
                <div class="p-6">
                    <div class="prose prose-sm max-w-none text-gray-700 bg-gray-50 p-4 rounded-lg border-2 border-gray-200 max-h-64 overflow-y-auto mb-4">
                        @Html.Raw(Markdig.Markdown.ToHtml(p.WaiverText))
                    </div>

                    <label class="flex items-start gap-3 p-4 rounded-lg border-2 border-gray-300 bg-white hover:border-emerald-400 hover:bg-emerald-50/40 cursor-pointer transition-all has-[:checked]:border-emerald-500 has-[:checked]:bg-emerald-50 has-[:checked]:shadow-md">
                        <input asp-for="WaiverAccepted" type="checkbox" required class="mt-0.5 h-5 w-5 rounded border-2 border-gray-300 text-emerald-600 focus:ring-4 focus:ring-emerald-500/15" />
                        <div class="flex-1">
                            <div class="text-sm font-bold text-gray-900">I have read and agree to the waiver above.</div>
                            <div class="text-xs text-gray-600 mt-0.5">Required to enroll.</div>
                        </div>
                    </label>
                    <span asp-validation-for="WaiverAccepted" class="@errorClass block ml-1"></span>

                    <label class="mt-3 flex items-start gap-3 p-4 rounded-lg border-2 border-gray-200 bg-white hover:border-emerald-400 hover:bg-emerald-50/40 cursor-pointer transition-all has-[:checked]:border-emerald-500 has-[:checked]:bg-emerald-50">
                        <input asp-for="PhotoReleaseGranted" type="checkbox" class="mt-0.5 h-5 w-5 rounded border-2 border-gray-300 text-emerald-600 focus:ring-4 focus:ring-emerald-500/15" />
                        <div class="flex-1">
                            <div class="text-sm font-semibold text-gray-900">Photo/video release <span class="text-xs font-normal text-gray-500">(optional)</span></div>
                            <div class="text-xs text-gray-600 mt-0.5">
                                @if (isAdult)
                                {
                                    <text>I grant Lake Country Spanish permission to photograph or video me during
                                    program activities for use on the website, social media, or promotional materials.
                                    You can leave this unchecked and still enroll.</text>
                                }
                                else
                                {
                                    <text>I grant Lake Country Spanish permission to photograph or video my child during
                                    program activities for use on the website, social media, or promotional materials.
                                    You can leave this unchecked and still enroll.</text>
                                }
                            </div>
                        </div>
                    </label>
                </div>
            </section>

            <!-- Submit -->
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pt-2 pb-8">
                <p class="text-xs text-gray-600 order-2 sm:order-1">
                    Questions? Call <a href="tel:@p.ContactPhone" class="font-semibold text-indigo-700 hover:underline">@p.ContactPhone</a>
                    or email <a href="mailto:@p.ContactEmail" class="font-semibold text-indigo-700 hover:underline">@p.ContactEmail</a>.
                </p>
                <button type="submit" class="order-1 sm:order-2 inline-flex items-center justify-center gap-2 px-8 py-3.5 bg-secondary-500 text-white text-base font-bold rounded-xl shadow-lg shadow-secondary-500/30 hover:bg-secondary-600 hover:shadow-secondary-500/40 focus:outline-none focus:ring-4 focus:ring-secondary-500/30 transition-all">
                    Complete enrollment
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                    </svg>
                </button>
            </div>
        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
